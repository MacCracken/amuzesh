# amuzesh benchmarks — every hot path of the public surface.
# Stdlib auto-included via cyrius.cyml.
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.
# Each loop is batched so the clock read (measured and subtracted by lib/bench.cyr) is
# amortised over the whole batch. Results feed bench-history.csv (scripts/bench-history.sh)
# and docs/benchmarks.md.
#
# One fixture for every row: amz_make_blobs(128 per blob, d = 8, k = 8, seed 7), so
# n = 1024 points in 8 dimensions, 8 well-separated clusters. The row names are stable
# across releases; change the fixture only together with a new baseline stamp.
#
# The allocator never frees (lib/alloc.cyr is a bump allocator), so iteration counts are
# sized to keep the whole run in tens of MB even where a call allocates.

include "lib/ganita.cyr"
include "lib/tyche.cyr"
include "src/dist.cyr"
include "src/check.cyr"
include "src/kmeans.cyr"
include "src/proto.cyr"
include "src/data.cyr"

# One batched row per hot path, in the order of the bench-history.csv columns.
fn main(): i64 {
    alloc_init();
    var n_per = 128; var d = 8; var k = 8;
    var n = k * n_per;
    var X = ganita_mat_new(n, d);
    var y = alloc(n * 8);
    amz_make_blobs(n_per, d, k, 7, X, y);
    var fit0 = amz_kmeans_fit(X, n, d, k, 50, 1337);
    var cents = amz_model_centroids(fit0);
    var labels = amz_model_labels(fit0);
    var protos = amz_proto_fit(X, n, d, y, k);
    var lab_out = alloc(n * 8);
    var cent_out = ganita_mat_new(k, d);
    var sink = 0;
    var i = 0;

    var b1 = bench_new("sqdist");
    bench_batch_start(b1);
    i = 0;
    while (i < 1000000) { sink = sink + amz_sqdist(X, i & 1023, cents, i & 7, d); i = i + 1; }
    bench_batch_stop(b1, 1000000);
    bench_report(b1);

    var b2 = bench_new("kmeans_assign");
    bench_batch_start(b2);
    i = 0;
    while (i < 2000) { sink = sink + amz_kmeans_assign(X, n, d, cents, k, lab_out); i = i + 1; }
    bench_batch_stop(b2, 2000);
    bench_report(b2);

    var b3 = bench_new("kmeans_update");
    bench_batch_start(b3);
    i = 0;
    while (i < 2000) { sink = sink + amz_kmeans_update(X, n, d, labels, k, cent_out); i = i + 1; }
    bench_batch_stop(b3, 2000);
    bench_report(b3);

    var b4 = bench_new("kmeans_pp_seed");
    bench_batch_start(b4);
    i = 0;
    while (i < 500) { rng_seed(i); sink = sink + amz_kmeans_pp_seed(X, n, d, k, cent_out); i = i + 1; }
    bench_batch_stop(b4, 500);
    bench_report(b4);

    var b5 = bench_new("kmeans_fit");
    bench_batch_start(b5);
    i = 0;
    while (i < 200) { sink = sink + amz_kmeans_fit(X, n, d, k, 50, 1337 + i); i = i + 1; }
    bench_batch_stop(b5, 200);
    bench_report(b5);

    var b6 = bench_new("proto_fit");
    bench_batch_start(b6);
    i = 0;
    while (i < 2000) { sink = sink + amz_proto_fit(X, n, d, y, k); i = i + 1; }
    bench_batch_stop(b6, 2000);
    bench_report(b6);

    var b7 = bench_new("proto_predict");
    bench_batch_start(b7);
    i = 0;
    while (i < 1000000) { sink = sink + amz_proto_predict(protos, k, d, X, i & 1023); i = i + 1; }
    bench_batch_stop(b7, 1000000);
    bench_report(b7);

    var b8 = bench_new("purity");
    bench_batch_start(b8);
    i = 0;
    while (i < 2000) { sink = sink + amz_purity(labels, y, n, k, k); i = i + 1; }
    bench_batch_stop(b8, 2000);
    bench_report(b8);

    if (sink == 1) { return 1; }   # keep every result observable
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
