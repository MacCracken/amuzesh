# amuzesh — M0 unit suite. Classical/shallow ML has NO finite-difference gradient gate
# (k-means / prototype are not gradient methods); correctness is proven by convergence
# (monotone inertia + fixed-point labels), coverage (cluster purity), exact analytic
# means, and held-out accuracy on separable sets. Stdlib auto-included via cyrius.cyml.

include "lib/ganita.cyr"
include "lib/tyche.cyr"
include "src/dist.cyr"
include "src/kmeans.cyr"
include "src/proto.cyr"
include "src/data.cyr"

fn EPS6(): i64 { return f64_div(f64_from(1), f64_from(1000000)); }    # 1e-6
fn feq(a, b): i64 { if (f64_lt(f64_abs(f64_sub(a, b)), EPS6()) == 1) { return 1; } return 0; }

# all entries of two rows×cols ganita matrices equal?
fn amz_mat_eq(A, B, rows, cols): i64 {
    var r = 0;
    while (r < rows) {
        var c = 0;
        while (c < cols) { if (feq(ganita_mat_get(A, r, c), ganita_mat_get(B, r, c)) == 0) { return 0; } c = c + 1; }
        r = r + 1;
    }
    return 1;
}
# two label vectors of length n equal?
fn labels_eq(a, b, n): i64 {
    var i = 0;
    while (i < n) { if (load64(a + i * 8) != load64(b + i * 8)) { return 0; } i = i + 1; }
    return 1;
}
# all pairwise sq-distances among k centroid rows exceed minsq?
fn seeds_spread(C, k, d, minsq): i64 {
    var i = 0;
    while (i < k) {
        var j = i + 1;
        while (j < k) { if (f64_gt(amz_sqdist(C, i, C, j, d), minsq) == 0) { return 0; } j = j + 1; }
        i = i + 1;
    }
    return 1;
}
# inertia history non-increasing within an absolute slack of 1.0 (f64 rounding)?
fn hist_monotone(hist, iters): i64 {
    var t = 1;
    while (t < iters) {
        if (f64_gt(load64(hist + t * 8), f64_add(load64(hist + (t - 1) * 8), f64_from(1))) == 1) { return 0; }
        t = t + 1;
    }
    return 1;
}

fn main() {
    alloc_init();
    # shared separable-blobs fixture (reused by the seeding / fit / classifier groups)
    var n_per = 30; var d = 2; var k = 3; var n = k * n_per;
    var X = ganita_mat_new(n, d); var y = alloc(n * 8);
    amz_make_blobs(n_per, d, k, 7, X, y);

    test_group("dist / util");
    var M = ganita_mat_new(3, 2);
    ganita_mat_set(M, 0, 0, f64_from(0)); ganita_mat_set(M, 0, 1, f64_from(0));   # (0,0)
    ganita_mat_set(M, 1, 0, f64_from(3)); ganita_mat_set(M, 1, 1, f64_from(4));   # (3,4)
    var R = ganita_mat_new(1, 2);
    amz_copy_row(M, 1, R, 0, 2);
    assert(feq(amz_sqdist(M, 0, M, 0, 2), f64_from(0)), "sqdist(p, p) == 0");
    assert(feq(amz_sqdist(M, 0, M, 1, 2), f64_from(25)), "sqdist((0,0),(3,4)) == 25");
    assert(feq(amz_sqdist(M, 0, M, 1, 2), amz_sqdist(M, 1, M, 0, 2)), "sqdist symmetric");
    assert((feq(ganita_mat_get(R, 0, 0), f64_from(3)) == 1) && (feq(ganita_mat_get(R, 0, 1), f64_from(4)) == 1), "copy_row copies the row");

    test_group("k-means++ seeding");
    var C1 = ganita_mat_new(k, d); rng_seed(1337); amz_kmeans_pp_seed(X, n, d, k, C1);
    var C2 = ganita_mat_new(k, d); rng_seed(1337); amz_kmeans_pp_seed(X, n, d, k, C2);
    assert(amz_mat_eq(C1, C2, k, d) == 1, "k-means++ reproducible under a fixed seed");
    assert(seeds_spread(C1, k, d, f64_from(25)) == 1, "k-means++ seeds land in distinct blobs (pairwise far)");

    test_group("Lloyd assign / update");
    var TX = ganita_mat_new(4, 2);
    ganita_mat_set(TX, 0, 0, f64_from(0));  ganita_mat_set(TX, 0, 1, f64_from(0));
    ganita_mat_set(TX, 1, 0, f64_from(0));  ganita_mat_set(TX, 1, 1, f64_from(2));
    ganita_mat_set(TX, 2, 0, f64_from(10)); ganita_mat_set(TX, 2, 1, f64_from(10));
    ganita_mat_set(TX, 3, 0, f64_from(10)); ganita_mat_set(TX, 3, 1, f64_from(12));
    var TC = ganita_mat_new(2, 2);
    ganita_mat_set(TC, 0, 0, f64_from(0));  ganita_mat_set(TC, 0, 1, f64_from(0));
    ganita_mat_set(TC, 1, 0, f64_from(10)); ganita_mat_set(TC, 1, 1, f64_from(10));
    var tlab = alloc(4 * 8);
    var tin = amz_kmeans_assign(TX, 4, 2, TC, 2, tlab);
    assert((load64(tlab) == 0) && (load64(tlab + 8) == 0) && (load64(tlab + 16) == 1) && (load64(tlab + 24) == 1), "assign -> nearest-centroid labels");
    assert(feq(tin, f64_from(8)), "assign inertia == summed min sq-dist (0+4+0+4)");
    var empty = amz_kmeans_update(TX, 4, 2, tlab, 2, TC);
    assert((feq(ganita_mat_get(TC, 0, 0), f64_from(0)) == 1) && (feq(ganita_mat_get(TC, 0, 1), f64_from(1)) == 1), "update centroid0 == cluster mean (0,1)");
    assert((feq(ganita_mat_get(TC, 1, 0), f64_from(10)) == 1) && (feq(ganita_mat_get(TC, 1, 1), f64_from(11)) == 1), "update centroid1 == cluster mean (10,11)");
    assert(empty == 0, "no empty clusters on the toy");
    var TC3 = ganita_mat_new(3, 2);
    ganita_mat_set(TC3, 2, 0, f64_from(99)); ganita_mat_set(TC3, 2, 1, f64_from(99));   # sentinel prior centroid
    var tl3 = alloc(4 * 8);
    store64(tl3, 0); store64(tl3 + 8, 0); store64(tl3 + 16, 1); store64(tl3 + 24, 1);    # nobody in cluster 2
    var empty3 = amz_kmeans_update(TX, 4, 2, tl3, 3, TC3);
    assert((empty3 == 1) && (feq(ganita_mat_get(TC3, 2, 0), f64_from(99)) == 1), "empty cluster retains prior centroid + counted");

    test_group("k-means fit convergence");
    var model = amz_kmeans_fit(X, n, d, k, 50, 1337);
    var iters = amz_model_iters(model);
    var hist = amz_model_history(model);
    var labs = amz_model_labels(model);
    assert(hist_monotone(hist, iters) == 1, "inertia history is non-increasing (Lloyd invariant)");
    assert(iters < 50, "converged before max_iter on separable data");
    var chk = alloc(n * 8);
    amz_kmeans_assign(X, n, d, amz_model_centroids(model), k, chk);
    assert(labels_eq(chk, labs, n) == 1, "post-fit assign is a fixed point (labels stable)");
    assert(f64_gt(amz_purity(labs, y, n, k, k), f64_div(f64_from(94), f64_from(100))) == 1, "cluster purity > 94% on 3 blobs");
    var model2 = amz_kmeans_fit(X, n, d, k, 50, 1337);
    assert(labels_eq(amz_model_labels(model2), labs, n) == 1, "fit reproducible under a fixed seed");

    test_group("prototype classifier");
    var protos = amz_proto_fit(X, n, d, y, k);
    var py = alloc(4 * 8); store64(py, 0); store64(py + 8, 0); store64(py + 16, 1); store64(py + 24, 1);
    var tp = amz_proto_fit(TX, 4, 2, py, 2);
    assert((feq(ganita_mat_get(tp, 0, 1), f64_from(1)) == 1) && (feq(ganita_mat_get(tp, 1, 1), f64_from(11)) == 1), "prototype == analytic class mean");
    assert(amz_proto_predict(tp, 2, 2, TX, 0) == 0, "predict -> class 0 for a class-0 point");
    assert(amz_proto_predict(tp, 2, 2, TX, 2) == 1, "predict -> class 1 for a class-1 point");
    assert(f64_gt(amz_proto_accuracy(protos, k, d, X, n, y), f64_div(f64_from(94), f64_from(100))) == 1, "3-class accuracy > 94% on separable blobs");
    var n2 = 2 * n_per; var X2 = ganita_mat_new(n2, d); var y2 = alloc(n2 * 8);
    amz_make_blobs(n_per, d, 2, 5, X2, y2);
    var protos2 = amz_proto_fit(X2, n2, d, y2, 2);
    assert(f64_gt(amz_proto_accuracy(protos2, 2, d, X2, n2, y2), f64_div(f64_from(94), f64_from(100))) == 1, "2-class accuracy > 94%");
    var protos3 = amz_proto_fit(X, n, d, y, k);
    assert(amz_mat_eq(protos, protos3, k, d) == 1, "prototype fit is deterministic (byte-identical refit)");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
