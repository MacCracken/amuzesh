[package]
name = "amuzesh"
version = "${file:VERSION}"
description = "amuzesh — Persian آموزش 'learning'; the AGNOS ML family's first classical / shallow-ML reference in Cyrius (the first NON-deep-learning sibling). Built ON the substrate (ganita linear algebra + tyche PRNG); the novelty budget is the model logic only."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.18"
repository = "https://github.com/MacCracken/amuzesh"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "build/amuzesh"

# `cyrius distlib` concatenates [lib].modules, in this order (the include order, since
# cyrius is single-pass), into dist/amuzesh.cyr: the one file a consumer includes, via
# `[deps.amuzesh] modules = ["dist/amuzesh.cyr"]`, after ganita's and tyche's bundles.
# src/data.cyr (the amz_make_blobs fixture) ships in the bundle; whether it stays public
# API is the 0.5.x freeze review's call. main.cyr (the M0 demo) and test.cyr are excluded:
# they carry main() + SYS_EXIT, not library surface.
[lib]
modules = ["src/dist.cyr", "src/check.cyr", "src/kmeans.cyr", "src/proto.cyr", "src/data.cyr"]

# Unlike the deep-learning siblings (attn11 / tarka / tentib / prajna), amuzesh carries
# NO finite-difference gradient gate: k-means / prototype are not gradient methods.
# Correctness is proven by convergence (monotone inertia + fixed-point labels),
# coverage (cluster purity), and accuracy (held-out separable sets) instead.
[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench", "math"]

# Dense f64 matrix storage + row access. amuzesh stores X (N×D), centroids (K×D) and
# class prototypes (C×D) as ganita matrices and reads them via ganita_mat_get/set — it
# does NOT reimplement any linear algebra.
#
# `1.1.0` → `1.2.14` (6.6.20 realign): the version the 6.6.20 snapshot bundles — the
# tag's dist/ganita.cyr is byte-identical to the toolchain's lib/ganita.cyr. No public
# signature changed across 1.2.x; ganita_mat_new/get/set behave as before.
#
# `1.2.14` → `1.2.15` (6.7.9 realign): the version the 6.7.9 snapshot bundles — again
# byte-identical to the toolchain's lib/ganita.cyr. Toolchain-only release (6.6.18 → 6.7.5);
# every function, signature and result is 1.2.14's.
#
# Held at `1.2.15` for the 6.7.18 bump: it is ganita's latest tag, and the 6.7.18 snapshot
# bundles the same bytes.
[deps.ganita]
git = "https://github.com/MacCracken/ganita"
tag = "1.2.15"
modules = ["dist/ganita.cyr"]

# Deterministic statistical PRNG (xorshift64). k-means++ seeding + the synthetic blob
# generator. tyche has NO weighted/categorical sampler, so the D²-weighted draw is built
# locally on rng_uniform() (model logic, in budget).
#
# `1.0.1` → `1.1.1` (6.6.20 realign): the tyche release built against 6.6.20.
# rng_seed / rng_u64 / rng_uniform are bit-identical; 1.1.0's portable-log rng_normal
# moves 0.011% of x86_64 draws by 1–3 ulp (blob jitter only — the gates are purity /
# accuracy, not stored bits). The frozen 1.x API is unchanged.
#
# `1.1.1` → `1.2.0` (6.7.9 realign): the tyche release built against 6.7.9. No library or
# API change; tyche's golden dump of the stream is byte-identical to 1.1.1's.
#
# `1.2.0` → `1.2.2` (6.7.18 bump, latest tag): 1.2.1 is toolchain-only (→ 6.7.18). 1.2.2 is
# the hardening sweep: every state the API can reach gives the same bits. A hand-written
# `_rng_state = 0` now steps as state 1 instead of hanging rng_normal; amuzesh never writes
# `_rng_state`. rng_uniform becomes `#inline`.
[deps.tyche]
git = "https://github.com/MacCracken/tyche"
tag = "1.2.2"
modules = ["dist/tyche.cyr"]
