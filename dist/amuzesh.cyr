# Version: 0.3.0
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# Requires (compile-verified; the leaves of dist/amuzesh.deps):
include "lib/alloc.cyr"

# --- dist.cyr ---

# amuzesh — shared row access and distance kernels.
#
# These are the ONLY model-level numeric primitives amuzesh adds; everything below
# them (matrix storage, PRNG) comes from ganita + tyche. All values are f64 bit
# patterns stored in i64 (the everything-is-i64 family convention).
#
# This is the first module of dist/amuzesh.cyr (`cyrius distlib`). A consumer of the
# bundle supplies ganita and tyche itself, before the bundle: declare `[deps.ganita]` and
# `[deps.tyche]` (cyrius deps then prepends lib/ganita.cyr and lib/tyche.cyr), or include
# those two files first. The bundle's `# Requires` block brings the stdlib leaves it needs.
#
# ⚠ UNCHECKED BY DESIGN. Every function in this file is an inner-loop kernel: it does
# no bounds, null or finiteness test, exactly like ganita_mat_get / ganita_mat_set.
# The public entry points in kmeans.cyr / proto.cyr / data.cyr validate their
# arguments once (src/check.cyr) and then call these. A caller using them directly
# owns the preconditions stated on each function.
#
# Include AFTER lib/ganita.cyr.

# Address of row r of ganita matrix m (ADR 0003). ganita lays a matrix out as
# { rows: i64, cols: i64, data: f64[rows*cols] } row-major, and documents
# ganita_mat_get as reading `m + 16 + (r*cols + c)*8`; this is that address with
# c = 0. tests/amuzesh.tcyr pins it against ganita_mat_get, so a layout change in
# ganita fails the suite instead of reading the wrong memory.
# Precondition: m is a ganita matrix and 0 <= r < rows(m).
#inline
fn _amz_row(m, r): i64 {
    return m + 16 + r * load64(m + 8) * 8;
}

# Squared euclidean distance between two rows of d f64 values, given their addresses.
# Precondition: pa and pb each point at d readable f64 values.
fn _amz_sqdist_ptr(pa, pb, d): i64 {
    var acc = f64_from(0);
    var end = pa + d * 8;
    while (pa < end) {
        var diff = f64_sub(load64(pa), load64(pb));
        acc = f64_add(acc, f64_mul(diff, diff));
        pa = pa + 8;
        pb = pb + 8;
    }
    return acc;
}

# Partial-distance search: like _amz_sqdist_ptr, but stops as soon as the running sum is no
# longer below `bound` and returns that partial sum (>= bound). Adding a non-negative
# square never lowers an f64 sum, so a cut row could not have won a strict `< bound` test:
# every argmin decision, and the winner's full distance, is bit-identical to the full sum.
fn _amz_sqdist_lt(pa, pb, d, bound): i64 {
    var acc = f64_from(0);
    var end = pa + d * 8;
    while (pa < end) {
        var diff = f64_sub(load64(pa), load64(pb));
        acc = f64_add(acc, f64_mul(diff, diff));
        if (f64_lt(acc, bound) == 0) { return acc; }
        pa = pa + 8;
        pb = pb + 8;
    }
    return acc;
}

# Squared euclidean distance between row ra of matrix A and row rb of matrix B over the
# first d columns. Precondition: ra and rb are in range and d <= cols of both.
fn amz_sqdist(A, ra, B, rb, d): i64 {
    return _amz_sqdist_ptr(_amz_row(A, ra), _amz_row(B, rb), d);
}

# Copy row rs of matrix src into row rd of matrix dst (the first d columns).
# Precondition: rs and rd are in range and d <= cols of both. Returns 0.
fn amz_copy_row(src, rs, dst, rd, d): i64 {
    var ps = _amz_row(src, rs);
    var pd = _amz_row(dst, rd);
    var c = 0;
    while (c < d) { store64(pd + c * 8, load64(ps + c * 8)); c = c + 1; }
    return 0;
}

# Store v into each of the count i64 slots starting at p.
fn _amz_fill_words(p, count, v): i64 {
    var end = p + count * 8;
    while (p < end) { store64(p, v); p = p + 8; }
    return 0;
}

# Per-label means of the rows of X (n×d), by Welford's running mean: each row with label
# j counts toward j and moves means[j] by (x − mean)·(1/count). `means` is k·d contiguous
# words (row j at means + j·d·8) and `counts` k words; both are overwritten. A label with
# no rows leaves count 0 and a zero row.
#
# Why not sum / count: the mean of identical rows must be that row, exactly. A running
# sum of n copies of x, divided by n, is generally an ulp off x, and k-means then sees a
# centroid move off its points: ties shift labels for up to k passes and the inertia
# rises from 0 to rounding noise (found by the fuzz harness, 2026-11-09). Here the
# increment for an identical row is exactly 0. The running mean's error also does not
# grow with the cluster's size, and it overflows only when the data's range exceeds
# DBL_MAX, where a sum overflows once n·max|x| does.
# Precondition: every label is in [0, k); X has at least n rows of d columns.
fn _amz_label_means(X, n, d, labels, k, means, counts): i64 {
    var stride = d * 8;
    _amz_fill_words(means, k * d, 0);   # +0.0
    _amz_fill_words(counts, k, 0);
    var px = _amz_row(X, 0);
    var i = 0;
    while (i < n) {
        var lab = load64(labels + i * 8);
        var cnt = load64(counts + lab * 8) + 1;
        store64(counts + lab * 8, cnt);
        var inv = f64_div(f64_from(1), f64_from(cnt));   # exactly 1.0 for a cluster's first row
        var pm = means + lab * stride;
        var c = 0;
        while (c < d) {
            var m = load64(pm + c * 8);
            store64(pm + c * 8, f64_add(m, f64_mul(f64_sub(load64(px + c * 8), m), inv)));
            c = c + 1;
        }
        px = px + stride;
        i = i + 1;
    }
    return 0;
}

# --- check.cyr ---

# amuzesh — argument validation and the failure vocabulary (ADR 0002).
#
# One vocabulary across the public surface, ganita's (ganita ADR 0001):
#
#   the function returns                          on failure
#   a pointer (a model, a prototype matrix)       0
#   a status, a count or a class index (>= 0)     AMZ_ERR_ALLOC (-1) or AMZ_ERR_ARG (-2)
#   an f64 (inertia, purity, accuracy)            NaN (AMZ_NAN)
#
# and ganita's rule for NaN and infinity (ganita ADR 0004): a function that JUDGES its
# input (fit, seeding, assignment, prototype fit, predict, accuracy) refuses a non-finite
# entry before it writes anything; a function that only CARRIES values
# (amz_kmeans_update, a mean) propagates them, as IEEE arithmetic does.
#
# Every public entry point validates once, here, and then runs the unchecked kernels in
# src/dist.cyr. Raw i64 arrays (labels, y) carry no length, so their length is the
# caller's `n` — the one thing amuzesh cannot check.
#
# Include AFTER lib/ganita.cyr, src/dist.cyr.

# The allocator is amuzesh's own direct need (alloc, ALLOC_MAX), so it is named here:
# `cyrius distlib` starts dist/amuzesh.deps from the includes the bundled modules keep,
# and its verify would otherwise credit the leaf to ganita, whose bundle also brings it.
include "lib/alloc.cyr"

var AMZ_ERR_ALLOC = 0 - 1;               # an allocation failed
var AMZ_ERR_ARG = 0 - 2;                 # an argument broke the contract (null, shape, range, NaN)
var AMZ_NAN = 0x7FF8000000000000;        # quiet NaN: the f64 failure value

# Policy cap on max_iter (ADR 0002). A fit allocates its inertia history up front, so the
# cap bounds what one call can take from the never-freeing heap: 10,000 × 8 B = 80 KB.
var AMZ_KMEANS_MAX_ITER = 10000;

# 1 if the f64 bit pattern x is finite (not NaN, not ±inf). Tests the exponent bits, so
# it does not depend on how a target compares a NaN.
#inline
fn _amz_is_finite(x): i64 {
    return (x & 0x7FF0000000000000) != 0x7FF0000000000000;
}

# 1 if the f64 bit pattern x is a NaN (either sign, quiet or signalling).
#inline
fn _amz_is_nan(x): i64 {
    return (x & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000;
}

# 1 if every one of the count f64 values starting at address p is finite.
fn _amz_words_finite(p, count): i64 {
    var end = p + count * 8;
    while (p < end) {
        if (_amz_is_finite(load64(p)) == 0) { return 0; }
        p = p + 8;
    }
    return 1;
}

# 1 if m is a ganita matrix with at least `rows` rows and exactly `cols` columns, and
# both requested sizes are positive. Exact columns: a d that disagrees with the matrix
# is a caller bug, never a request to use a column prefix.
fn _amz_mat_ok(m, rows, cols): i64 {
    if (m == 0) { return 0; }
    if ((rows < 1) || (cols < 1)) { return 0; }
    if (ganita_mat_rows(m) < rows) { return 0; }
    if (ganita_mat_cols(m) != cols) { return 0; }
    return 1;
}

# 1 if the first `rows` rows of m (cols columns each) are all finite.
# Precondition: _amz_mat_ok(m, rows, cols).
fn _amz_mat_finite(m, rows, cols): i64 {
    return _amz_words_finite(_amz_row(m, 0), rows * cols);
}

# 1 if labels is non-null and each of its n i64 entries lies in [0, k).
fn _amz_labels_ok(labels, n, k): i64 {
    if (labels == 0) { return 0; }
    var i = 0;
    while (i < n) {
        var v = load64(labels + i * 8);
        if ((v < 0) || (v >= k)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 if the n i64 words at a and b are pairwise equal (stops at the first difference).
fn _amz_words_eq(a, b, n): i64 {
    var i = 0;
    while (i < n) {
        if (load64(a + i * 8) != load64(b + i * 8)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Allocate `count` i64 slots, or return 0 for a count below 1 or one whose byte size
# would exceed ALLOC_MAX (so `count * 8` cannot wrap). Not zeroed.
fn _amz_alloc_words(count): i64 {
    if (count < 1) { return 0; }
    if (count > ALLOC_MAX / 8) { return 0; }
    return alloc(count * 8);
}

# --- kmeans.cyr ---

# amuzesh — k-means clustering (Lloyd 1957/1982) with k-means++ seeding
# (Arthur & Vassilvitskii 2007). The genuinely-new content of M0: assignment,
# centroid update, inertia, the D²-weighted seed walk, and the fit driver. Matrix
# storage and the PRNG are substrate (ganita / tyche), not reimplemented here.
#
# A fitted model is a flat 9-slot record (alloc'd i64 array):
#   [0]=k  [1]=d  [2]=n  [3]=centroids (k×d ganita matrix)  [4]=labels (i64[n])
#   [5]=inertia (f64)  [6]=iters  [7]=history (i64[max_iter]; the first `iters` hold the
#   inertia after each assignment)  [8]=converged (1 = labels reached a fixed point)
# Read it through the amz_model_* accessors.
#
# Every public function validates its arguments and fails in the vocabulary of
# src/check.cyr (ADR 0002); the _amz_* kernels below assume a validated call.
#
# Include AFTER lib/ganita.cyr, lib/tyche.cyr, src/dist.cyr, src/check.cyr.

var _AMZ_MODEL_SLOTS = 9;

# ---- k-means++ seeding ------------------------------------------------------
# Kernel: choose k centers from X (n×d), D²-weighted, writing the chosen data rows into
# cents (k×d). `dist` is n words of scratch (the running nearest-center squared
# distance). The RNG must be seeded by the caller. tyche has no weighted sampler, so the
# categorical draw is an inverse-CDF walk over rng_uniform(), stopped at the first index
# whose running sum passes the draw. The fold uses partial-distance search against each
# point's current minimum (see _amz_sqdist_lt); every choice is bit-identical to 0.2.1's.
# Precondition: validated as amz_kmeans_pp_seed does; X finite.
fn _amz_pp_seed(X, n, d, k, cents, dist): i64 {
    var stride = d * 8;
    var x0 = _amz_row(X, 0);
    var first = (rng_u64() & 0x7FFFFFFFFFFFFFFF) % n;   # first center: a uniform data point
    amz_copy_row(X, first, cents, 0, d);
    var pc = _amz_row(cents, 0);
    var total = f64_from(0);
    var px = x0;
    var i = 0;
    while (i < n) {
        var d0 = _amz_sqdist_ptr(px, pc, d);
        store64(dist + i * 8, d0);
        total = f64_add(total, d0);
        px = px + stride;
        i = i + 1;
    }
    var c = 1;
    while (c < k) {
        var u = f64_mul(rng_uniform(), total);   # in [0, total): rng_uniform() < 1 rounds below total
        var cum = f64_from(0);
        var pick = 0 - 1;
        i = 0;
        while (i < n) {
            cum = f64_add(cum, load64(dist + i * 8));
            if (f64_gt(cum, u) == 1) { pick = i; break; }
            i = i + 1;
        }
        if (pick < 0) { pick = n - 1; }   # total == 0: every point already sits on a center
        amz_copy_row(X, pick, cents, c, d);
        if (c + 1 < k) {
            # Fold the new center into the running minimum and re-total, in the same
            # index order the walk reads, for the next draw. The last center needs no fold.
            pc = _amz_row(cents, c);
            total = f64_from(0);
            px = x0;
            i = 0;
            while (i < n) {
                var dmin = load64(dist + i * 8);
                var dn = _amz_sqdist_lt(px, pc, d, dmin);
                if (f64_lt(dn, dmin) == 1) { dmin = dn; store64(dist + i * 8, dn); }
                total = f64_add(total, dmin);
                px = px + stride;
                i = i + 1;
            }
        }
        c = c + 1;
    }
    return 0;
}

# Choose k initial centers from X (n×d) D²-weighted (k-means++), writing the chosen data
# rows into out_cents (at least k×d). The RNG must be seeded by the caller.
# RETURNS 0, AMZ_ERR_ARG (X / out_cents shape, k outside [1, n], a non-finite entry
# of X), or AMZ_ERR_ALLOC.
fn amz_kmeans_pp_seed(X, n, d, k, out_cents): i64 {
    if (_amz_mat_ok(X, n, d) == 0) { return AMZ_ERR_ARG; }
    if ((k < 1) || (k > n)) { return AMZ_ERR_ARG; }
    if (_amz_mat_ok(out_cents, k, d) == 0) { return AMZ_ERR_ARG; }
    if (_amz_mat_finite(X, n, d) == 0) { return AMZ_ERR_ARG; }
    var dist = _amz_alloc_words(n);
    if (dist == 0) { return AMZ_ERR_ALLOC; }
    return _amz_pp_seed(X, n, d, k, out_cents, dist);
}

# ---- Lloyd iteration --------------------------------------------------------
# Kernel: label each of the n rows of X with its nearest centroid (ties go to the lowest
# index) and RETURN the inertia, the sum of those minimum squared distances. Candidates
# after the first are measured by partial-distance search against the best so far, which
# leaves every label and the inertia bit-identical to the full sums.
# Precondition: validated as amz_kmeans_assign does.
fn _amz_assign(X, n, d, cents, k, out_labels): i64 {
    var stride = d * 8;
    var c0 = _amz_row(cents, 0);
    var inertia = f64_from(0);
    var px = _amz_row(X, 0);
    var i = 0;
    while (i < n) {
        var best = 0;
        var bestd = _amz_sqdist_ptr(px, c0, d);
        var pc = c0 + stride;
        var j = 1;
        while (j < k) {
            var dj = _amz_sqdist_lt(px, pc, d, bestd);
            if (f64_lt(dj, bestd) == 1) { bestd = dj; best = j; }
            pc = pc + stride;
            j = j + 1;
        }
        store64(out_labels + i * 8, best);
        inertia = f64_add(inertia, bestd);
        px = px + stride;
        i = i + 1;
    }
    return inertia;
}

# Assign each of the n rows of X (n×d) to its nearest of the k centroid rows of cents
# (k×d), filling out_labels[0..n). RETURNS the inertia (the sum of the chosen squared
# distances) as an f64, or NaN for a bad shape, a null out_labels, k < 1, or a
# non-finite entry in X or cents.
fn amz_kmeans_assign(X, n, d, cents, k, out_labels): i64 {
    if (_amz_mat_ok(X, n, d) == 0) { return AMZ_NAN; }
    if (_amz_mat_ok(cents, k, d) == 0) { return AMZ_NAN; }
    if (out_labels == 0) { return AMZ_NAN; }
    if (_amz_mat_finite(X, n, d) == 0) { return AMZ_NAN; }
    if (_amz_mat_finite(cents, k, d) == 0) { return AMZ_NAN; }
    return _amz_assign(X, n, d, cents, k, out_labels);
}

# Kernel: recompute each centroid as the mean of its assigned rows (the SSE minimizer for
# a fixed assignment), by the running mean of _amz_label_means. An EMPTY cluster keeps its
# previous centroid. `means` (k·d words) and `counts` (k words) are scratch. RETURNS the
# number of empty clusters. Precondition: validated as amz_kmeans_update does.
fn _amz_update(X, n, d, labels, k, cents, means, counts): i64 {
    _amz_label_means(X, n, d, labels, k, means, counts);
    var stride = d * 8;
    var empty = 0;
    var j = 0;
    while (j < k) {
        if (load64(counts + j * 8) == 0) { empty = empty + 1; }
        else {
            var pm = means + j * stride;
            var pc = _amz_row(cents, j);
            var c = 0;
            while (c < d) { store64(pc + c * 8, load64(pm + c * 8)); c = c + 1; }
        }
        j = j + 1;
    }
    return empty;
}

# Recompute each of the k centroid rows of out_cents as the mean of the rows of X whose
# label is that cluster. An EMPTY cluster keeps its previous centroid (no divide by
# zero, no NaN). RETURNS the empty-cluster count, AMZ_ERR_ARG (a bad shape, k < 1, or a
# label outside [0, k)), or AMZ_ERR_ALLOC. A carrier: non-finite input propagates.
fn amz_kmeans_update(X, n, d, labels, k, out_cents): i64 {
    if (_amz_mat_ok(X, n, d) == 0) { return AMZ_ERR_ARG; }
    if (_amz_mat_ok(out_cents, k, d) == 0) { return AMZ_ERR_ARG; }
    if (_amz_labels_ok(labels, n, k) == 0) { return AMZ_ERR_ARG; }
    var means = _amz_alloc_words(k * d);
    var counts = _amz_alloc_words(k);
    if ((means == 0) || (counts == 0)) { return AMZ_ERR_ALLOC; }
    return _amz_update(X, n, d, labels, k, out_cents, means, counts);
}

# ---- fit driver -------------------------------------------------------------
# Full Lloyd loop: k-means++ seed, then assign <-> update until the label vector reaches
# a fixed point or max_iter assignments have run. Inertia is recorded AFTER each assign
# (against the centroids that produced those labels), so the history is directly
# checkable for the Lloyd non-increasing invariant.
#
# The returned model is always self-consistent: its labels are the nearest-centroid
# labels of its centroids, and its inertia is theirs. When the budget runs out first,
# the last update is skipped rather than leaving labels that describe older centroids;
# amz_model_converged() tells the two endings apart.
#
# Everything the fit needs is allocated once, before the loop, so a fit's memory does not
# grow with its iteration count (the heap never frees; see lib/alloc.cyr).
#
# RETURNS a model record (see the header), or 0 for a bad shape, k outside [1, n],
# max_iter outside [1, AMZ_KMEANS_MAX_ITER], a non-finite entry of X, or an allocation
# failure. Seeds tyche's global stream with `seed`.
fn amz_kmeans_fit(X, n, d, k, max_iter, seed): i64 {
    if (_amz_mat_ok(X, n, d) == 0) { return 0; }
    if ((k < 1) || (k > n)) { return 0; }
    if ((max_iter < 1) || (max_iter > AMZ_KMEANS_MAX_ITER)) { return 0; }
    if (_amz_mat_finite(X, n, d) == 0) { return 0; }
    var cents = ganita_mat_new(k, d);
    var cur = _amz_alloc_words(n);
    var prev = _amz_alloc_words(n);       # also the seeding scratch: seeding ends before it is read
    var history = _amz_alloc_words(max_iter);
    var means = _amz_alloc_words(k * d);
    var counts = _amz_alloc_words(k);
    var model = _amz_alloc_words(_AMZ_MODEL_SLOTS);
    if ((cents == 0) || (cur == 0) || (prev == 0)) { return 0; }
    if ((history == 0) || (means == 0) || (counts == 0) || (model == 0)) { return 0; }

    rng_seed(seed);
    _amz_pp_seed(X, n, d, k, cents, prev);
    _amz_fill_words(prev, n, 0 - 1);      # matches no label: forces the first update
    var inertia = f64_from(0);
    var iters = 0;
    var converged = 0;
    while (iters < max_iter) {
        inertia = _amz_assign(X, n, d, cents, k, cur);
        store64(history + iters * 8, inertia);
        iters = iters + 1;
        if (_amz_words_eq(cur, prev, n) == 1) { converged = 1; break; }
        if (iters == max_iter) { break; }   # out of budget: keep the centroids that produced `cur`
        _amz_update(X, n, d, cur, k, cents, means, counts);
        var swap = prev;
        prev = cur;
        cur = swap;
    }
    store64(model + 0 * 8, k);
    store64(model + 1 * 8, d);
    store64(model + 2 * 8, n);
    store64(model + 3 * 8, cents);
    store64(model + 4 * 8, cur);
    store64(model + 5 * 8, inertia);
    store64(model + 6 * 8, iters);
    store64(model + 7 * 8, history);
    store64(model + 8 * 8, converged);
    return model;
}

# ---- model accessors --------------------------------------------------------
# Each accessor is null-safe, so a refused fit (model 0) reads as a failure instead of
# a crash: a pointer field reads 0, a count reads AMZ_ERR_ARG, the inertia reads NaN.

# Number of clusters k.
fn amz_model_k(m): i64 { if (m == 0) { return AMZ_ERR_ARG; } return load64(m + 0 * 8); }
# Dimension d.
fn amz_model_d(m): i64 { if (m == 0) { return AMZ_ERR_ARG; } return load64(m + 1 * 8); }
# Number of fitted rows n.
fn amz_model_n(m): i64 { if (m == 0) { return AMZ_ERR_ARG; } return load64(m + 2 * 8); }
# The k×d centroid matrix.
fn amz_model_centroids(m): i64 { if (m == 0) { return 0; } return load64(m + 3 * 8); }
# The n final labels (i64 array).
fn amz_model_labels(m): i64 { if (m == 0) { return 0; } return load64(m + 4 * 8); }
# Inertia of the final labels against the final centroids (f64).
fn amz_model_inertia(m): i64 { if (m == 0) { return AMZ_NAN; } return load64(m + 5 * 8); }
# Number of assignments run (1..max_iter).
fn amz_model_iters(m): i64 { if (m == 0) { return AMZ_ERR_ARG; } return load64(m + 6 * 8); }
# Per-assignment inertia history (f64 array; the first amz_model_iters() entries are set).
fn amz_model_history(m): i64 { if (m == 0) { return 0; } return load64(m + 7 * 8); }
# 1 if the labels reached a fixed point, 0 if max_iter ran out first.
fn amz_model_converged(m): i64 { if (m == 0) { return AMZ_ERR_ARG; } return load64(m + 8 * 8); }

# 1 if an inertia history of `iters` f64 entries never rises by more than a relative
# 1e-9 between consecutive entries (Lloyd's invariant, with room for rounding), 0 if it
# does, AMZ_ERR_ARG for a null history or iters < 1. The slack is relative, so the verdict
# does not depend on the scale of the data.
fn amz_inertia_monotone(history, iters): i64 {
    if ((history == 0) || (iters < 1)) { return AMZ_ERR_ARG; }
    var slack = f64_add(f64_from(1), f64_div(f64_from(1), f64_from(1000000000)));
    var t = 1;
    while (t < iters) {
        var allowed = f64_mul(load64(history + (t - 1) * 8), slack);
        if (f64_gt(load64(history + t * 8), allowed) == 1) { return 0; }
        t = t + 1;
    }
    return 1;
}

# ---- coverage metric --------------------------------------------------------
# Cluster purity = (1/n) Σ_clusters max_class (#points of that true class in the
# cluster) — permutation-invariant, so it does not depend on the arbitrary cluster
# numbering. labels lie in [0, k), y in [0, ncls).
#
# One pass checks both label ranges while threading each cluster's members into a list
# (nothing but purity's own scratch is written before the check finishes). Each list is
# then counted once against a histogram stamped with the cluster that last wrote each
# entry, so a count left by an earlier cluster reads as 0 without a clearing pass:
# O(n + k + ncls) time and memory, never 0.2.1's O(k·n).
# RETURNS an f64 fraction in [0, 1], or NaN for n < 1, k < 1, ncls < 1, a null array, a
# label outside its range, or an allocation failure.
fn amz_purity(labels, y, n, k, ncls): i64 {
    if ((n < 1) || (k < 1) || (ncls < 1)) { return AMZ_NAN; }
    if ((labels == 0) || (y == 0)) { return AMZ_NAN; }
    var head = _amz_alloc_words(k);
    var nxt = _amz_alloc_words(n);
    var hist = _amz_alloc_words(ncls);
    var stamp = _amz_alloc_words(ncls);
    if ((head == 0) || (nxt == 0) || (hist == 0) || (stamp == 0)) { return AMZ_NAN; }
    _amz_fill_words(head, k, 0 - 1);
    _amz_fill_words(stamp, ncls, 0 - 1);
    var i = 0;
    while (i < n) {
        var lab = load64(labels + i * 8);
        var cls = load64(y + i * 8);
        if ((lab < 0) || (lab >= k) || (cls < 0) || (cls >= ncls)) { return AMZ_NAN; }
        store64(nxt + i * 8, load64(head + lab * 8));
        store64(head + lab * 8, i);
        i = i + 1;
    }
    var total_major = 0;
    var j = 0;
    while (j < k) {
        var mx = 0;
        var p = load64(head + j * 8);
        while (p >= 0) {
            var t = load64(y + p * 8);
            var h = 1;
            if (load64(stamp + t * 8) == j) { h = load64(hist + t * 8) + 1; }
            else { store64(stamp + t * 8, j); }
            store64(hist + t * 8, h);
            if (h > mx) { mx = h; }
            p = load64(nxt + p * 8);
        }
        total_major = total_major + mx;
        j = j + 1;
    }
    return f64_div(f64_from(total_major), f64_from(n));
}

# --- proto.cyr ---

# amuzesh — nearest-centroid (prototype / Rocchio / nearest-mean) classifier.
#
# Supervised, RNG-free. The prototype for class c is the componentwise mean of all
# training rows labeled c; a query is classified to the nearest prototype. Equivalent
# to LDA under equal isotropic covariance — the supervised counterpart to k-means.
#
# A class with NO training rows has no mean, so it has no prototype: its row is NaN and
# it is never predicted (ADR 0004). Every public function validates its arguments and
# fails in the vocabulary of src/check.cyr (ADR 0002).
#
# Include AFTER lib/ganita.cyr, src/dist.cyr, src/check.cyr.

# Fit: prototype[c] = mean of the rows of X (n×d) with y == c, stored as row c of a
# ncls×d ganita matrix; a class with no rows gets a NaN row. y holds n labels in
# [0, ncls). RETURNS the prototype matrix, or 0 for a bad shape, ncls < 1, a label
# outside [0, ncls), a non-finite entry of X, or an allocation failure.
fn amz_proto_fit(X, n, d, y, ncls): i64 {
    if (_amz_mat_ok(X, n, d) == 0) { return 0; }
    if (ncls < 1) { return 0; }
    if (_amz_labels_ok(y, n, ncls) == 0) { return 0; }
    if (_amz_mat_finite(X, n, d) == 0) { return 0; }
    var protos = ganita_mat_new(ncls, d);
    var counts = _amz_alloc_words(ncls);
    if ((protos == 0) || (counts == 0)) { return 0; }
    # The running means are written straight into the matrix's ncls·d data words.
    _amz_label_means(X, n, d, y, ncls, _amz_row(protos, 0), counts);
    var j = 0;
    while (j < ncls) {
        if (load64(counts + j * 8) == 0) { _amz_fill_words(_amz_row(protos, j), d, AMZ_NAN); }   # ADR 0004
        j = j + 1;
    }
    return protos;
}

# Kernel: the class whose prototype is nearest the d-value query row at address q, ties
# to the lowest index. A class whose distance is NaN (it has no prototype) never wins.
# After the first candidate, distances use partial-distance search (_amz_sqdist_lt): a NaN
# row stops at its first coordinate and is still skipped.
# RETURNS the class, or AMZ_ERR_ARG when no class has a prototype.
# Precondition: protos is validated (ncls×d) and the query row is finite.
fn _amz_proto_nearest(protos, ncls, d, q): i64 {
    var stride = d * 8;
    var pc = _amz_row(protos, 0);
    var best = AMZ_ERR_ARG;
    var bestd = 0;
    var c = 0;
    while (c < ncls) {
        var dc = 0;
        if (best < 0) { dc = _amz_sqdist_ptr(q, pc, d); } else { dc = _amz_sqdist_lt(q, pc, d, bestd); }
        if (_amz_is_nan(dc) == 0) {
            if ((best < 0) || (f64_lt(dc, bestd) == 1)) { best = c; bestd = dc; }
        }
        pc = pc + stride;
        c = c + 1;
    }
    return best;
}

# Predict: argmin_c sqdist(query, prototype_c), where the query is row rx of matrix Xq
# (d columns). RETURNS the class in [0, ncls), or AMZ_ERR_ARG for a bad shape, rx out of
# range, a non-finite query, or a prototype set in which no class has a prototype.
fn amz_proto_predict(protos, ncls, d, Xq, rx): i64 {
    if (_amz_mat_ok(protos, ncls, d) == 0) { return AMZ_ERR_ARG; }
    if ((rx < 0) || (_amz_mat_ok(Xq, rx + 1, d) == 0)) { return AMZ_ERR_ARG; }
    var q = _amz_row(Xq, rx);
    if (_amz_words_finite(q, d) == 0) { return AMZ_ERR_ARG; }
    return _amz_proto_nearest(protos, ncls, d, q);
}

# Accuracy over a labeled set (X n×d, y labels in [0, ncls)). RETURNS the f64 fraction
# predicted correctly, or NaN for a bad shape, a label outside [0, ncls), a non-finite
# entry of X, or a prototype set in which no class has a prototype.
fn amz_proto_accuracy(protos, ncls, d, X, n, y): i64 {
    if (_amz_mat_ok(protos, ncls, d) == 0) { return AMZ_NAN; }
    if (_amz_mat_ok(X, n, d) == 0) { return AMZ_NAN; }
    if (_amz_labels_ok(y, n, ncls) == 0) { return AMZ_NAN; }
    if (_amz_mat_finite(X, n, d) == 0) { return AMZ_NAN; }
    var stride = d * 8;
    var px = _amz_row(X, 0);
    var ok = 0;
    var i = 0;
    while (i < n) {
        var cls = _amz_proto_nearest(protos, ncls, d, px);
        if (cls < 0) { return AMZ_NAN; }
        if (cls == load64(y + i * 8)) { ok = ok + 1; }
        px = px + stride;
        i = i + 1;
    }
    return f64_div(f64_from(ok), f64_from(n));
}

# --- data.cyr ---

# amuzesh — synthetic fixtures: well-separated Gaussian blobs for tests + demo.
#
# Include AFTER lib/ganita.cyr, lib/tyche.cyr, src/dist.cyr, src/check.cyr.

# Generate k Gaussian blobs of n_per points each in d dims, written into the first
# k·n_per rows of out_X (d columns) and the k·n_per labels of out_y. Cluster c is
# centered at coordinate ((c+1)·10 + axis) on every axis (centers 10·√d apart: ~14 for
# d = 2) with unit-std noise — cleanly separable (≈10σ per axis), so k-means purity and
# prototype accuracy should be ~1.0. Seeds tyche's global stream with `seed`.
# RETURNS the point count k·n_per, or AMZ_ERR_ARG for n_per, d or k below 1, a count
# too large for a ganita matrix, or an out_X / out_y that cannot hold it.
fn amz_make_blobs(n_per, d, k, seed, out_X, out_y): i64 {
    if ((n_per < 1) || (d < 1) || (k < 1)) { return AMZ_ERR_ARG; }
    if (k > GANITA_MAT_MAX_ELEMS / n_per) { return AMZ_ERR_ARG; }   # k·n_per must not wrap
    var n = k * n_per;
    if (_amz_mat_ok(out_X, n, d) == 0) { return AMZ_ERR_ARG; }
    if (out_y == 0) { return AMZ_ERR_ARG; }
    rng_seed(seed);
    var px = _amz_row(out_X, 0);
    var row = 0;
    var ci = 0;
    while (ci < k) {
        var pi = 0;
        while (pi < n_per) {
            var c = 0;
            while (c < d) {
                var center = f64_from((ci + 1) * 10 + c);
                store64(px + c * 8, f64_add(center, rng_normal()));
                c = c + 1;
            }
            store64(out_y + row * 8, ci);
            px = px + d * 8;
            row = row + 1;
            pi = pi + 1;
        }
        ci = ci + 1;
    }
    return n;
}
